{
  "name": "duelux-store",
  "version": "1.0.0",
  "private": true,
  "description": "Unified E-Commerce, In-House POS, Barcode Labeling & Inventory Engine",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "npm run generate --workspace=@duelux/db",
    "db:migrate": "npm run migrate --workspace=@duelux/db",
    "db:push": "npm run push --workspace=@duelux/db",
    "db:studio": "npm run studio --workspace=@duelux/db",
    "dev:api": "npm run dev --workspace=@duelux/api",
    "dev:pos": "npm run dev --workspace=@duelux/pos"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
